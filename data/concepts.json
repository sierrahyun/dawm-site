[{"id":"ha","name":"히알루론산","en":"Hyaluronic acid","aliases":["히알루론산","하이알루론산","히알","HA","hyaluronic","저분자","고분자"],"sum":"물을 붙잡는 보습 성분. 크기(분자량)와 형태에 따라 머무는 곳이 달라요.","desc":"히알루론산은 피부 속에도 있는 긴 당 사슬이에요. 전성분에는 '히알루론산'이라는 이름 대신 염·저분자·가교형 같은 여러 이름으로 적혀요. 크기가 다른 것을 섞으면 표면과 속을 함께 채워요. 건조한 곳에선 위에 크림으로 덮어줘야 수분이 날아가지 않아요.","chain":null,"cols":["크기·형태","머무는 곳","느낌"],"members":[{"id":"hyaluronic-acid","v":["고분자","피부 표면","즉각적인 매끈함"]},{"id":"sodium-hyaluronate","v":["중~고분자(제품마다)","표면~각질층 위","가장 흔한 기본형"]},{"id":"potassium-ha","v":["염(칼륨)","표면~각질층 위","소듐형과 비슷"]},{"id":"hydrolyzed-ha","v":["저분자","각질층 사이","속당김 완화"]},{"id":"hydrolyzed-sodium-ha","v":["초저분자","각질층 깊숙이","가볍게 스며듦"]},{"id":"acetylated-ha","v":["유도체","각질층","보습 지속↑"]},{"id":"ha-crosspolymer","v":["가교(그물)","표면","오래 머무는 막"]},{"id":"ha-cation","v":["양이온 유도체","표면에 밀착","씻겨도 남는 보습"]}],"rel":[{"id":"nmf","t":"함께 쓰면 좋아요"},{"id":"barrier","t":"위에 덮어주기"},{"id":"soothing","t":"수분 진정 조합"}]},{"id":"retinoid","name":"레티노이드","en":"Retinoids (vitamin A)","aliases":["레티놀","레티노이드","비타민A","레티날","트레티노인","레티노산","retinol","retinal","레티닐","바쿠치올"],"sum":"비타민A 계열. 피부 속에서 레티노산으로 바뀌는 단계가 짧을수록 강하고 자극도 커요.","desc":"레티노이드는 세포 교체를 빠르게 해 주름·피부결·트러블 자국에 효과적인 성분군이에요. 피부는 '레티노산' 형태만 직접 쓰기 때문에, 바르는 형태가 레티노산에서 멀수록 순하고 느려요. 처음엔 저농도로 주 2~3회, 밤에만, 다음 날 자외선 차단은 필수예요. 임신 중에는 피해요.","chain":["레티닐팔미테이트","레티놀","레티날","레티노산(트레티노인)"],"cols":["단계","강도","자극","구분"],"members":[{"id":"retinyl-palmitate","v":["3단계 전","약함","적음","화장품"]},{"id":"retinol","v":["2단계 전","중간","중간","화장품 · 주름 기능성"]},{"id":"retinal","v":["1단계 전","강함","중간~큼","화장품"]},{"id":"hpr","v":["직접 작용 에스터","중간","적은 편","화장품"]},{"id":"tretinoin","v":["최종 활성형","가장 강함","큼","처방 의약품"]},{"id":"adapalene","v":["합성 레티노이드","강함","중간~큼","의약품(여드름)"]},{"id":"bakuchiol","v":["레티노이드 아님(유사 작용)","약~중간","적음","화장품 · 대안"]}],"rel":[{"id":"uv","t":"다음 날 꼭 함께"},{"id":"exfoliant","t":"같은 밤엔 피하기"},{"id":"barrier","t":"자극 완충"},{"id":"acne","t":"트러블 관리와 연결"}]},{"id":"vitc","name":"비타민C","en":"Vitamin C","aliases":["비타민C","비타민씨","비씨","아스코빅","아스코르빈산","vitamin c","비타민"],"sum":"톤을 밝히고 항산화하는 성분. 순수형은 강하지만 불안정해서 여러 유도체가 있어요.","desc":"순수 비타민C(아스코빅애씨드)는 효과가 빠르지만 빛·공기에 쉽게 산화되고 낮은 pH라 따가울 수 있어요. 그래서 안정성을 높인 유도체들이 많아요. 유도체는 피부에서 천천히 비타민C로 바뀌어 순하지만 체감은 느린 편이에요. 비타민E와 함께 쓰면 항산화 효과가 커져요.","chain":null,"cols":["형태","안정성","자극","특징"],"members":[{"id":"ascorbic-acid","v":["순수형","낮음","있음","가장 강력·빠름"]},{"id":"ethyl-ascorbic","v":["에틸 유도체","높음","적음","순수형에 가까운 효과"]},{"id":"ascorbyl-glucoside","v":["당 결합","높음","적음","천천히 전환"]},{"id":"map","v":["인산염(마그네슘)","높음","적음","미백 기능성 원료"]},{"id":"sap","v":["인산염(나트륨)","높음","적음","트러블 피부에도"]},{"id":"ati","v":["지용성","높음","적음","오일·크림 제형"]},{"id":"ascorbyl-palmitate","v":["지용성","보통","적음","주로 항산화 보조"]}],"rel":[{"id":"brighten","t":"톤 개선 동료"},{"id":"uv","t":"아침 자외선 차단과 시너지"},{"id":"retinoid","t":"같은 시간대는 나눠 쓰기"}]},{"id":"barrier","name":"세콜지 · 피부장벽","en":"Ceramide · Cholesterol · Fatty acids","aliases":["세라마이드","세콜지","장벽","피부장벽","콜레스테롤","지방산","ceramide","장벽크림"],"sum":"세라마이드·콜레스테롤·지방산. 각질세포 사이를 메우는 '모르타르'예요.","desc":"각질층 지질은 대략 세라마이드 50%, 콜레스테롤 25%, 지방산 10~20%로 이뤄져요. 세 가지를 함께 줄 때 장벽 회복이 빨랐다는 연구들이 있어요. 전성분에 셋이 모두 보이면 장벽을 염두에 두고 설계한 제품일 가능성이 높아요.","chain":null,"cols":["종류","역할"],"members":[{"id":"ceramide-np","v":["세라마이드","가장 대표적인 장벽 세라마이드"]},{"id":"ceramide-ap","v":["세라마이드","각질층 결속"]},{"id":"ceramide-eop","v":["세라마이드","긴 사슬로 층을 엮음"]},{"id":"ceramide-ns","v":["세라마이드","각질층에 많은 종류"]},{"id":"pseudo-ceramide","v":["유사 세라마이드","안정적·고함량 배합"]},{"id":"phytosphingosine","v":["세라마이드 뼈대","장벽+진정"]},{"id":"cholesterol","v":["콜레스테롤","3대 지질"]},{"id":"fatty-acids","v":["지방산","3대 지질"]},{"id":"mle-ceramide","v":["유사 세라마이드","층상 구조로 장벽 보충"]},{"id":"phytosterols","v":["식물성 스테롤","콜레스테롤 대신 지질 보충"]},{"id":"ceramide-as","v":["세라마이드","각질층 결속 보조"]}],"rel":[{"id":"ha","t":"수분 채우고 덮기"},{"id":"soothing","t":"민감할 때 함께"},{"id":"retinoid","t":"레티놀 자극 완충"}]},{"id":"exfoliant","name":"각질 제거 산","en":"AHA · BHA · PHA · LHA","aliases":["각질","필링","AHA","BHA","PHA","LHA","산","살리실릭","글라이콜릭","락틱","모공"],"sum":"오래된 각질을 녹이는 산. 분자가 작을수록 빠르고 강해요.","desc":"AHA는 물에 녹아 표면 각질과 톤에, BHA는 기름에 녹아 모공 속 피지에 강해요. PHA·LHA는 분자가 크거나 천천히 작용해서 민감 피부용으로 쓰여요. 산을 쓴 날엔 레티노이드를 쉬고, 다음 날 자외선 차단을 꼼꼼히 해요.","chain":null,"cols":["계열","분자 크기","강도","이런 피부에"],"members":[{"id":"glycolic-acid","v":["AHA","가장 작음","강함","저항·각질 두꺼운 피부"]},{"id":"lactic-acid","v":["AHA","작음","중간","건조한 피부"]},{"id":"mandelic","v":["AHA","큼","약~중간","민감·트러블"]},{"id":"salicylic-acid","v":["BHA","작음(지용성)","중간","지성·모공·여드름"]},{"id":"betaine-salicylate","v":["BHA 대체","중간","약함","순한 BHA"]},{"id":"lha","v":["LHA","큼(지용성)","약함","민감한 지성"]},{"id":"gluconolactone","v":["PHA","큼","약함","민감 피부"]},{"id":"lactobionic","v":["PHA","가장 큼","약함","민감·건성"]}],"rel":[{"id":"retinoid","t":"같은 밤엔 피하기"},{"id":"acne","t":"모공·트러블 관리"},{"id":"uv","t":"다음 날 차단 필수"}]},{"id":"brighten","name":"미백 · 톤 성분","en":"Brightening","aliases":["미백","톤업","기미","잡티","브라이트닝","색소","자국","나이아신","알부틴","트라넥삼"],"sum":"멜라닌이 만들어지거나 옮겨가는 단계를 줄여 톤을 고르게 해요.","desc":"색소는 '만들기 → 옮기기 → 쌓이기' 단계를 거쳐요. 성분마다 막는 단계가 달라서 서로 다른 단계의 성분을 함께 쓰면 효율이 좋아요. 무엇보다 자외선 차단이 가장 강력한 미백이에요.","chain":null,"cols":["막는 단계","특징"],"members":[{"id":"niacinamide","v":["옮기기(멜라닌 이동)","장벽·피지까지 다재다능"]},{"id":"arbutin","v":["만들기","미백 기능성 고시"]},{"id":"alpha-arbutin","v":["만들기","알부틴의 한 형태"]},{"id":"tranexamic-acid","v":["신호 줄이기","기미에 많이 쓰임"]},{"id":"ethyl-ascorbic","v":["만들기·항산화","비타민C 유도체"]},{"id":"glutathione","v":["항산화·톤","보조 성분"]},{"id":"azelaic-acid","v":["만들기·염증","붉은기·트러블에도"]}],"rel":[{"id":"vitc","t":"항산화 동료"},{"id":"uv","t":"가장 중요한 짝"},{"id":"exfoliant","t":"쌓인 색소 각질 정리"}]},{"id":"cica","name":"시카 · 병풀","en":"Centella asiatica","aliases":["시카","병풀","마데카","마데카소사이드","센텔라","cica","centella"],"sum":"병풀에서 나온 진정·회복 성분 묶음이에요.","desc":"'시카'는 병풀(Centella asiatica)을 말해요. 추출물 자체보다 그 안의 활성 성분(마데카소사이드·아시아티코사이드·마데카식애씨드·아시아틱애씨드)이 이름에 따로 적혀 있으면 함량을 신경 쓴 제품인 경우가 많아요.","chain":null,"cols":["정체","역할"],"members":[{"id":"centella","v":["원료 추출물","진정 전반"]},{"id":"madecassoside","v":["활성 성분","붉은기·회복"]},{"id":"asiaticoside","v":["활성 성분 묶음","손상 회복"]}],"rel":[{"id":"soothing","t":"진정 성분 친구"},{"id":"barrier","t":"장벽 회복과 함께"},{"id":"acne","t":"트러블 진정"}]},{"id":"soothing","name":"진정 성분","en":"Soothing","aliases":["진정","수딩","홍조","붉은기","붉어짐","따가움","어성초","알로에","판테놀","캐모마일","쑥"],"sum":"열감·붉은기·따가움을 가라앉히는 성분들이에요.","desc":"진정 성분은 자극의 원인을 없애진 않지만 반응을 누그러뜨려요. 붉어짐이 잦다면 먼저 향료·알코올·강한 활성 성분을 빼고, 진정 성분 위주로 단순하게 가는 게 좋아요.","chain":null,"cols":["출처","특징"],"members":[{"id":"panthenol","v":["비타민B5","보습+진정 기본템"]},{"id":"allantoin","v":["컴프리 유래/합성","순한 진정"]},{"id":"houttuynia","v":["어성초","트러블·붉은기"]},{"id":"aloe","v":["알로에","열감·수분"]},{"id":"chamomile","v":["캐모마일","국화과 알레르기 주의"]},{"id":"mugwort","v":["쑥","한방 진정"]},{"id":"calamine","v":["광물","진정+피지 흡착"]},{"id":"beta-glucan","v":["귀리·효모","보습막+진정"]},{"id":"glycyrrhizate","v":["감초","붉은기 완화"]},{"id":"ectoin","v":["미생물 유래","환경 스트레스 보호"]},{"id":"troxerutin","v":["루틴 유도체","붉은기 보조"]},{"id":"bisabolol","v":["캐모마일","순하고 무난한 진정"]}],"rel":[{"id":"cica","t":"대표 진정 계열"},{"id":"barrier","t":"장벽 함께 챙기기"},{"id":"fragrance","t":"진정할 땐 빼기"}]},{"id":"uv","name":"자외선 차단 성분","en":"UV filters","aliases":["선크림","자외선","자차","무기자차","유기자차","SPF","PA","선케어","썬크림","sunscreen"],"sum":"무기자차는 빛을 튕겨내고, 유기자차는 흡수해 열로 바꿔요.","desc":"무기(물리적) 필터는 징크옥사이드·티타늄디옥사이드 두 가지로 자극이 적지만 백탁이 있을 수 있어요. 유기(화학적) 필터는 가볍고 투명하지만 일부는 민감 피부에서 눈시림·자극이 보고돼요. UVA와 UVB를 모두 막도록 여러 필터를 섞는 게 일반적이에요.","chain":null,"cols":["종류","막는 빛","특징"],"members":[{"id":"zinc-oxide","v":["무기","UVA·UVB","순함, 백탁 가능"]},{"id":"titanium-dioxide","v":["무기","UVB 위주","순함"]},{"id":"octinoxate","v":["유기","UVB","대표 필터, 일부 자극"]},{"id":"homosalate","v":["유기","UVB","배합 한도 있음"]},{"id":"ethylhexyl-salicylate","v":["유기","UVB","보조 필터"]},{"id":"isoamyl-mc","v":["유기","UVB","신나메이트 계열"]},{"id":"drometrizole","v":["유기","UVA·UVB","광안정"]},{"id":"ensulizole","v":["유기","UVB","수용성·가벼움"]},{"id":"ecamsule","v":["유기","UVA","수용성"]},{"id":"dhhb","v":["유기","UVA","광안정"]},{"id":"bemotrizinol","v":["유기","UVA·UVB","광안정·차세대"]},{"id":"avobenzone","v":["유기","UVA","안정화 필요"]},{"id":"octocrylene","v":["유기","UVB","안정화 보조, 알레르기 보고"]},{"id":"ethylhexyl-triazone","v":["유기","UVB","고효율"]},{"id":"tinosorb-m","v":["유기·무기 중간형","UVA·UVB","광안정, 백탁 적음"]},{"id":"iscotrizinol","v":["유기","UVB","광안정, 소량으로 효율적"]}],"rel":[{"id":"retinoid","t":"다음 날 꼭"},{"id":"brighten","t":"가장 강한 미백"},{"id":"vitc","t":"아침 항산화 짝"}]},{"id":"peptide","name":"펩타이드","en":"Peptides","aliases":["펩타이드","주름","탄력","콜라겐","peptide"],"sum":"아미노산 몇 개가 이어진 신호 물질. 탄력·주름 관리에 쓰여요.","desc":"펩타이드는 피부에 '콜라겐을 만들어' 같은 신호를 준다고 알려진 성분이에요. 레티노이드보다 자극이 적어 민감 피부의 탄력 관리용으로 좋아요. 다만 효과 근거는 성분마다 편차가 있어요.","chain":null,"cols":["역할"],"members":[{"id":"palmitoyl-peptides","v":["콜라겐 신호"]},{"id":"peptide-tetra11","v":["결속 단백질"]},{"id":"peptide-tetra9","v":["탄력 단백질"]},{"id":"peptide-hexa8","v":["표정 주름"]},{"id":"dipeptide2","v":["눈가 붓기"]},{"id":"collagen","v":["표면 보습(콜라겐이 되진 않아요)"]},{"id":"adenosine","v":["주름 개선 기능성(펩타이드는 아님)"]},{"id":"matrixyl","v":["콜라겐 신호"]},{"id":"copper-peptide","v":["회복·탄력(구리 결합)"]},{"id":"oligopeptide-1","v":["회복(EGF 유사)"]},{"id":"pdrn","v":["회복·탄력(연어 DNA 유래)"]},{"id":"pal-tripeptide-8","v":["진정·붉은기 완화"]},{"id":"syn-ake","v":["표정 주름 완화"]},{"id":"oligopeptide-68","v":["톤 개선"]}],"rel":[{"id":"retinoid","t":"자극 적은 대안·병행"},{"id":"uv","t":"탄력 지키기"}]},{"id":"fragrance","name":"향료 · 알레르기 성분","en":"Fragrance & allergens","aliases":["향료","향","알레르기","에센셜오일","리모넨","리날룰","무향","fragrance","parfum"],"sum":"좋은 향을 주지만 민감 피부 트러블의 흔한 원인이에요.","desc":"'향료(Parfum)'는 여러 향 원료를 묶은 이름이에요. 그중 알레르기를 잘 일으키는 성분은 따로 표시해야 해서 리모넨·리날룰 같은 이름이 전성분 끝에 보여요. 에센셜오일도 이런 성분을 품고 있어요. 민감(S) 피부라면 무향 제품부터 고르는 걸 권해요.","chain":null,"cols":["정체","주의"],"members":[{"id":"parfum","v":["향 혼합물","민감 피부 1순위 주의"]},{"id":"essential-oils","v":["천연 오일","시트러스는 광감작 가능"]},{"id":"limonene","v":["시트러스 향","산화되면 자극↑"]},{"id":"linalool","v":["라벤더 향","산화되면 자극↑"]},{"id":"citronellol","v":["장미 향","표시 의무"]},{"id":"geraniol","v":["장미 향","표시 의무"]},{"id":"citral","v":["레몬 향","표시 의무"]},{"id":"hexyl-cinnamal","v":["꽃향 성분","알레르기 유발 표시 대상"]}],"rel":[{"id":"soothing","t":"민감할 땐 빼고 진정"},{"id":"alcohol","t":"함께 자주 등장"}]},{"id":"ferment","name":"발효 성분","en":"Ferments","aliases":["발효","갈락토미세스","비피다","유산균","효모","ferment"],"sum":"미생물이 만든 발효물. 결·윤기·컨디션 개선에 쓰여요.","desc":"발효 성분은 원료를 미생물로 발효하거나 미생물 자체를 녹인 성분이에요. 아미노산·유기산 등이 풍부해 피부결과 윤기를 돕는다고 알려져 있어요. 사람마다 맞고 안 맞음이 갈리는 편이라 처음엔 패치 테스트를 권해요.","chain":null,"cols":["출처","특징"],"members":[{"id":"galactomyces","v":["효모 발효","결·윤기"]},{"id":"bifida","v":["비피더스균","장벽·컨디션"]},{"id":"ferment","v":["유산균·효모 등","컨디셔닝"]}],"rel":[{"id":"barrier","t":"장벽 컨디션"},{"id":"nmf","t":"보습 보조"}]},{"id":"alcohol","name":"알코올","en":"Alcohols","aliases":["알코올","에탄올","변성알코올","알콜","alcohol"],"sum":"'알코올'이라는 이름이 붙어도 다 같은 게 아니에요.","desc":"에탄올·변성알코올은 산뜻함과 흡수감을 주지만 앞쪽에 많이 들어가면 건조·민감 피부엔 따가울 수 있어요. 반면 세테아릴·세틸알코올 같은 '지방 알코올'은 오히려 보습감을 주는 고체 성분이라 피할 필요가 없어요.","chain":null,"cols":["종류","피부에"],"members":[{"id":"alcohol","v":["휘발성(에탄올)","산뜻함, 민감·건성 주의"]},{"id":"fatty-alcohols","v":["지방 알코올","보습·질감, 걱정 없음"]}],"rel":[{"id":"fragrance","t":"함께 자주 등장"},{"id":"soothing","t":"민감할 땐 피하기"}]},{"id":"nmf","name":"보습 인자","en":"Humectants & NMF","aliases":["보습","수분","글리세린","휴멕턴트","천연보습인자","NMF","속건조","당김"],"sum":"공기·피부 속 수분을 끌어와 붙잡는 성분들이에요.","desc":"글리세린, 아미노산, 우레아처럼 수분을 붙잡는 성분이 보습의 바탕이에요. 피부 자체가 가진 천연보습인자(NMF)와 비슷한 성분들이 많아 대부분 무난해요.","chain":null,"cols":["특징"],"members":[{"id":"glycerin","v":["가장 기본"]},{"id":"amino-acids","v":["천연보습인자"]},{"id":"urea","v":["보습+각질 연화"]},{"id":"betaine","v":["보습+자극 완화"]},{"id":"trehalose","v":["오래가는 촉촉함"]},{"id":"panthenol","v":["보습+진정"]},{"id":"polyglutamic","v":["큰 보습막"]}],"rel":[{"id":"ha","t":"대표 보습 성분"},{"id":"barrier","t":"수분 지키기"}]},{"id":"acne","name":"여드름 · 트러블 케어","en":"Acne care","aliases":["여드름","트러블","좁쌀","뾰루지","모공","피지","아젤리아","연고","acne"],"sum":"피지·각질·염증·균, 여드름의 네 가지 원인을 각각 다른 성분이 다뤄요.","desc":"여드름은 피지가 많아지고, 각질이 모공을 막고, 균과 염증이 더해지며 생겨요. 화장품 성분은 주로 피지·각질 쪽을, 의약품은 균·염증까지 다뤄요. 연고를 쓰는 중이라면 처방·설명서 안내가 우선이고, 각질 제거 산이나 레티놀과 겹칠 땐 시간을 나눠요.","chain":null,"cols":["구분","다루는 원인","주의"],"members":[{"id":"salicylic-acid","v":["화장품","각질·피지","건조감"]},{"id":"lha","v":["화장품","각질","순한 편"]},{"id":"niacinamide","v":["화장품","피지·염증","고농도 화끈"]},{"id":"zinc","v":["화장품","피지","-"]},{"id":"houttuynia","v":["화장품","진정","-"]},{"id":"tea-tree","v":["화장품","균","에센셜오일 자극"]},{"id":"azelaic-acid","v":["화장품/의약품(20%)","각질·균·염증·자국","초반 따끔"]},{"id":"adapalene","v":["의약품","각질·염증","레티노이드 겹침"]},{"id":"benzoyl-peroxide","v":["의약품","균","건조·탈색"]}],"rel":[{"id":"exfoliant","t":"모공 각질"},{"id":"retinoid","t":"겹치지 않게"},{"id":"soothing","t":"트러블 진정"},{"id":"cica","t":"회복"}]}]